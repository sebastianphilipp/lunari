@startuml
top to bottom direction

namespace common {
  enum Difficulty {
    Easy
    Medium
    Hard
  }
}

namespace app {
  class Manager

  enum Views {
    InGame
    Settings
  }

  interface View {
    + join() : void
    + signal change(Views)
    + exit() : void
    + render() : void
    + type() : Views
  }

  interface General {
    + fps() : size_t
  }

  Views --+ View
  Manager ..> "*" View
  Manager ..> General
}

namespace gui {
  class Settings
  class InGame
  class General
  class Game
  class Scoreboard

  struct Ghost {
    size_t x
    size_t y
    bool alive
  }

  struct Player {
    std::string name
    size_t x
    size_t y
    bool alive
  }

  interface GameSettings {
    + setName(std::string) : void
    + name() : std::string
    + setDifficulty(common::Difficulty) : void
    + difficulty() : common::Difficulty
  }

  interface ScoreboardSettings {
    + scoreBoard() : std::vector<std::tuple<std::string, size_t>>
  }

  interface KeyEvent {
    + signal key(code)
  }

  enum ExitType {
    Error
    Won
    Lost
  }

  interface GameController {
    + processKey(code)
  }

  interface GeneralSettings {
    + setFps(size_t) : void
    + fps() : size_t
  }

  interface MapSettings {
    + setMap(std::string) : void
    + map() : std::string
  }

  Settings ..|> app.View
  InGame ..|> app.View
  InGame ..> GameController
  InGame ..> MapSettings
  InGame ..> KeyEvent
  Settings ..> KeyEvent
  Scoreboard ..> KeyEvent
  General ..> KeyEvent
  Game ..> GameController
  Game ..|> app.View
  General ..|> app.View
  Scoreboard ..|> app.View
  Scoreboard ..> ScoreboardSettings
  General ..|> app.General
  General ..> GeneralSettings
  Ghost --+ GameController
  Player --+ GameController
  ExitType --+ GameController
}

namespace controller {
    class GameController

    interface MovementLogic {
        + move(key)
    }

    interface InteractionLogic {
        + interact(x, y)
    }

    interface CombatLogic {
        + hit(Player)
    }

    interface WorldState {
        + map() : array<Element>[][]
    }

    interface PlayerState {
        + players() : array<Player>[]
    }

    GameController ..|> gui.GameController
    GameController ..> MovementLogic
    GameController ..> CombatLogic
    GameController ..> InteractionLogic
    GameController ..> WorldState
    GameController ..> PlayerState
}

namespace logic {
    class Interaction
    class Movement
    class Combat

        interface WorldState {
            + map() : array<Element>[][]
        }

        interface PlayerState {
           + players() : array<Player>[]
        }

    Interaction ..|> controller.InteractionLogic
    Movement ..|> controller.MovementLogic
    Combat ..|> controller.CombatLogic
    Interaction ..> WorldState
    Movement ..> PlayerState
    Movement ..> WorldState
}

namespace state {
    class PlayerState
    class WorldState

    PlayerState ..|> logic.PlayerState
    PlayerState ..|> controller.PlayerState
    WorldState ..|> logic.WorldState
    WorldState ..|> controller.WorldState
}

namespace settings {
    class GameSettings
    class GeneralSettings
    class MapSettings

    interface SettingsFile {
        + read(std::string) : std::string
        + write(std::string, std::string) : void
    }

    GameSettings ..|> gui.GameSettings
    GeneralSettings ..|> gui.GeneralSettings
    GameSettings ..> SettingsFile
    GeneralSettings ..> SettingsFile
    MapSettings ..|> gui.MapSettings
    MapSettings ..> SettingsFile
}

namespace ini {
    class SettingsFile

    SettingsFile ..|> settings.SettingsFile
}

namespace event {
    class KeyEvent

    KeyEvent ..|> gui.KeyEvent
}

@enduml
